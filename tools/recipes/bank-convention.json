{
  "_note": "One grid and one key for the whole bank, and the accelerometer left in charge of X and Y. Slots 25-32 are the hand tuned sampler presets; the X/Y steps skip them because they are already set that way.",
  "steps": [
    { "param": "P_SEQ_CLK_DIV", "src": "base", "div": "1/4",  "slots": "1-32" },
    { "param": "P_ARP_CLK_DIV", "src": "base", "div": "1/16", "slots": "1-32" },
    { "param": "P_SWING",       "src": "base", "percent": 0,  "slots": "1-32" },

    { "param": "P_SCALE",       "src": "base", "index": 1,    "slots": "1-32" },
    { "param": "P_ROOT",        "src": "base", "index": 0,    "slots": "1-32" },

    { "param": "P_X_DEPTH",     "src": "base", "percent": 0,  "slots": "1-24" },
    { "param": "P_Y_DEPTH",     "src": "base", "percent": 0,  "slots": "1-24" },
    { "param": "P_X_OFFSET",    "src": "base", "percent": 0,  "slots": "1-24" },
    { "param": "P_Y_OFFSET",    "src": "base", "percent": 0,  "slots": "1-24" },
    { "param": "P_X_SHAPE",     "src": "base", "index": 0,    "slots": "1-24" },
    { "param": "P_Y_SHAPE",     "src": "base", "index": 0,    "slots": "1-24" },
    { "param": "P_X_SCALE",     "src": "base", "percent": 50, "slots": "1-24" },
    { "param": "P_Y_SCALE",     "src": "base", "percent": 50, "slots": "1-24" }
  ]
}
